<script>
(function(){
  "use strict";

  /* ---------- Routing ---------- */
  var routes = ["home","causes","effects","action","quiz","glossary"];
  var navLinks = document.querySelectorAll('.mainnav a[data-route]');
  var pages = {};
  routes.forEach(function(r){ pages[r] = document.getElementById('page-'+r); });

  function showRoute(route, moveFocus){
    if(routes.indexOf(route) === -1) route = "home";
    routes.forEach(function(r){
      pages[r].classList.toggle('is-active', r === route);
    });
    navLinks.forEach(function(a){
      if(a.getAttribute('data-route') === route){ a.setAttribute('aria-current','page'); }
      else { a.removeAttribute('aria-current'); }
    });
    if(moveFocus){
      var h1 = pages[route].querySelector('h1');
      if(h1){ h1.setAttribute('tabindex','-1'); h1.focus(); }
    }
  }

  function routeFromHash(){
    return (location.hash || '#home').replace('#','');
  }

  window.addEventListener('hashchange', function(){ showRoute(routeFromHash(), true); });
  showRoute(routeFromHash(), false);

  /* ---------- Display tools: font size + theme ---------- */
  var fontBtn = document.getElementById('fontToggle');
  var themeBtn = document.getElementById('themeToggle');

  function safeGet(key){ try { return localStorage.getItem(key); } catch(e){ return null; } }
  function safeSet(key,val){ try { localStorage.setItem(key,val); } catch(e){} }

  var fontLarge = safeGet('tg-fontsize') === 'large';
  document.body.dataset.fontsize = fontLarge ? 'large' : 'normal';
  fontBtn.setAttribute('aria-pressed', String(fontLarge));

  fontBtn.addEventListener('click', function(){
    fontLarge = !fontLarge;
    document.body.dataset.fontsize = fontLarge ? 'large' : 'normal';
    fontBtn.setAttribute('aria-pressed', String(fontLarge));
    safeSet('tg-fontsize', fontLarge ? 'large' : 'normal');
  });

  var savedTheme = safeGet('tg-theme');
  if(savedTheme === 'dark' || savedTheme === 'light'){
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeBtn.setAttribute('aria-pressed', String(savedTheme === 'dark'));
  }
  themeBtn.addEventListener('click', function(){
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    var next = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    themeBtn.setAttribute('aria-pressed', String(next === 'dark'));
    safeSet('tg-theme', next);
  });

  /* ---------- Greenhouse hotspots ---------- */
  var ghInfo = {
    sun: {title:"The sun", body:"Sunlight travels through the atmosphere and warms Earth's surface — this part of the system hasn't changed."},
    atmosphere: {title:"Greenhouse gases", body:"CO2, methane and other gases in the atmosphere trap some of that heat instead of letting it all escape to space. Human activity has been adding far more of these gases than natural processes remove."},
    surface: {title:"Earth's surface", body:"Land and oceans absorb energy from the sun, warm up, and then radiate that energy back out as heat."},
    heat: {title:"Trapped heat", body:"With more greenhouse gases in the atmosphere, more of that outgoing heat gets trapped and reflected back down — warming the surface further. This is the enhanced greenhouse effect."}
  };
  var ghButtons = document.querySelectorAll('.hotspot-btn');
  var ghPanel = document.getElementById('ghPanel');
  var ghParts = {
    sun: [document.getElementById('part-sun'), document.getElementById('part-sun-rays')],
    atmosphere: [document.getElementById('part-atmosphere'), document.getElementById('part-atmosphere-dot')].concat(Array.prototype.slice.call(document.querySelectorAll('.gh-atm-dot'))),
    surface: [document.getElementById('part-surface')],
    heat: [document.getElementById('part-heat')]
  };
  function setGhPart(part){
    ghButtons.forEach(function(b){ b.setAttribute('aria-pressed', String(b.dataset.part === part)); });
    Object.keys(ghParts).forEach(function(k){
      ghParts[k].forEach(function(el){ if(el){ el.classList.toggle('gh-active', k===part); } });
    });
    var info = ghInfo[part];
    ghPanel.innerHTML = '<strong>'+info.title+'</strong>'+info.body;
  }
  ghButtons.forEach(function(btn){
    btn.addEventListener('click', function(){ setGhPart(btn.dataset.part); });
  });
  setGhPart('sun');

  /* ---------- Tabs ---------- */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('#page-causes .tab'));
  function selectTab(tab){
    tabs.forEach(function(t){
      var selected = t === tab;
      t.setAttribute('aria-selected', String(selected));
      t.tabIndex = selected ? 0 : -1;
      var panel = document.getElementById(t.getAttribute('aria-controls'));
      panel.hidden = !selected;
      panel.classList.toggle('is-active', selected);
    });
    tab.focus();
  }
  tabs.forEach(function(tab, i){
    tab.addEventListener('click', function(){ selectTab(tab); });
    tab.addEventListener('keydown', function(e){
      var idx = i;
      if(e.key === 'ArrowRight'){ idx = (i+1) % tabs.length; selectTab(tabs[idx]); e.preventDefault(); }
      if(e.key === 'ArrowLeft'){ idx = (i-1+tabs.length) % tabs.length; selectTab(tabs[idx]); e.preventDefault(); }
    });
  });

  /* ---------- Timeline slider ---------- */
  var tlData = [
    {year:"1900s", temp:0.0, desc:"Global average temperature was close to its long-term baseline in the early 1900s, before large-scale industrial emissions took hold."},
    {year:"1920s", temp:0.1, desc:"Warming was still minimal in the early twentieth century."},
    {year:"1940s", temp:0.2, desc:"A slight rise, alongside growing industrial output worldwide."},
    {year:"1960s", temp:0.1, desc:"Global temperatures briefly plateaued, partly due to aerosol pollution reflecting sunlight."},
    {year:"1980s", temp:0.3, desc:"Warming resumed clearly as greenhouse gas emissions kept climbing."},
    {year:"1990s", temp:0.5, desc:"The 1990s were warmer than any decade on record up to that point."},
    {year:"2000s", temp:0.6, desc:"Nine of the ten warmest years on record (at the time) occurred in this decade."},
    {year:"2010s", temp:0.9, desc:"Extreme heat events became noticeably more frequent across many regions."},
    {year:"2020s", temp:1.2, desc:"Recent years have repeatedly ranked among the warmest ever recorded, with more frequent heatwaves and heavy rainfall events."},
    {year:"2030s (projected)", temp:1.4, desc:"Projections vary by emissions scenario — this range assumes only modest reductions in global emissions."},
    {year:"2050s (projected)", temp:1.8, desc:"Under a moderate-emissions pathway, warming continues well past today's levels."},
    {year:"2080s (projected)", temp:2.3, desc:"Higher-emissions pathways could see warming approach or exceed 2°C well before the end of the century."},
    {year:"2100 (projected)", temp:2.7, desc:"Long-range projections span a wide range depending on how quickly global emissions fall — this figure assumes limited action."}
  ];
  var tlRange = document.getElementById('tlRange');
  var tlTemp = document.getElementById('tlTemp');
  var tlYear = document.getElementById('tlYear');
  var tlDesc = document.getElementById('tlDesc');
  var tlBars = document.getElementById('tlBars');
  tlData.forEach(function(){
    var bar = document.createElement('i');
    tlBars.appendChild(bar);
  });
  var barEls = tlBars.children;
  function renderTimeline(i){
    var d = tlData[i];
    tlTemp.textContent = (d.temp>=0?'+':'') + d.temp.toFixed(1) + '°C';
    tlYear.textContent = d.year;
    tlDesc.textContent = d.desc;
    var maxTemp = 2.7;
    for(var j=0;j<barEls.length;j++){
      var h = Math.max(6, (tlData[j].temp/maxTemp)*66);
      barEls[j].style.height = h+'px';
      barEls[j].classList.toggle('on', j<=i);
    }
  }
  tlRange.addEventListener('input', function(){ renderTimeline(parseInt(tlRange.value,10)); });
  renderTimeline(0);

  /* ---------- Accordion ---------- */
  document.querySelectorAll('.acc-trigger').forEach(function(trigger){
    trigger.addEventListener('click', function(){
      var expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      var panel = document.getElementById(trigger.getAttribute('aria-controls'));
      panel.classList.toggle('is-open', !expanded);
    });
  });

  /* ---------- Action plan checklist ---------- */
  var planBoxes = Array.prototype.slice.call(document.querySelectorAll('[data-plan]'));
  var planCount = document.getElementById('planCount');
  document.getElementById('planTotal').textContent = planBoxes.length;

  function planKey(el){
    var group = el.closest('.plan-group').querySelector('h3').textContent;
    return group + '|' + el.closest('.plan-item').textContent.trim();
  }
  var savedPlan = [];
  try { savedPlan = JSON.parse(safeGet('tg-plan') || '[]'); } catch(e){ savedPlan = []; }
  planBoxes.forEach(function(box){
    if(savedPlan.indexOf(planKey(box)) !== -1){ box.checked = true; }
  });
  function updatePlanCount(){
    var checked = planBoxes.filter(function(b){ return b.checked; });
    planCount.textContent = checked.length;
    safeSet('tg-plan', JSON.stringify(checked.map(planKey)));
  }
  planBoxes.forEach(function(box){ box.addEventListener('change', updatePlanCount); });
  updatePlanCount();
  document.getElementById('planReset').addEventListener('click', function(){
    planBoxes.forEach(function(b){ b.checked = false; });
    updatePlanCount();
  });

  /* ---------- Quiz ---------- */
  var quizData = [
    {
      q: "Which of these is the single largest source of human-caused greenhouse gas emissions?",
      choices: ["Burning fossil fuels for energy and transport", "Rice farming", "Cement production", "Household waste"],
      correct: 0,
      explain: "Burning coal, oil and gas for electricity, heat and transport releases the largest share of human-caused CO2 emissions worldwide."
    },
    {
      q: "Why does deforestation contribute to climate change?",
      choices: ["It makes the soil less fertile", "It removes a natural store that absorbs CO2, and releases stored carbon", "It reduces rainfall in cities", "It increases methane from soil bacteria"],
      correct: 1,
      explain: "Trees absorb CO2 as they grow. Clearing them releases the carbon they stored and removes a system that would otherwise keep absorbing more."
    },
    {
      q: "Which gas do cattle and rice paddies produce large amounts of?",
      choices: ["Oxygen", "Nitrogen", "Methane", "Ozone"],
      correct: 2,
      explain: "Cattle digestion and flooded rice paddies are major sources of methane, a greenhouse gas that traps significantly more heat than CO2 in the short term."
    },
    {
      q: "What happens to sea levels as glaciers and ice sheets melt and oceans warm?",
      choices: ["They fall, because ice turns to water vapour", "They stay the same", "They rise, from meltwater and thermal expansion", "They only rise near the poles"],
      correct: 2,
      explain: "Melting ice adds water to the oceans, and warmer water also expands — both effects raise sea levels globally."
    },
    {
      q: "Which of these is a practical action within most students' control?",
      choices: ["Setting national energy policy", "Reducing food waste and choosing more meat-free meals", "Rerouting international shipping", "Regulating factory emissions directly"],
      correct: 1,
      explain: "Everyday choices — like reducing food waste, walking or cycling for short trips, and eating fewer meat-heavy meals — are realistic actions individuals can control, alongside pushing for wider policy change."
    },
    {
      q: "When researching climate claims online, what's the best approach?",
      choices: ["Trust whichever post has the most likes", "Check whether it's backed by established scientific bodies and cited evidence", "Assume all sources are equally reliable", "Avoid checking sources to save time"],
      correct: 1,
      explain: "Favour established scientific bodies like the IPCC, the Met Office or NASA, and check whether claims are backed by cited, peer-reviewed evidence."
    }
  ];
  var quizIdx = 0, quizScore = 0;
  var quizProgress = document.getElementById('quizProgress');
  var quizQuestion = document.getElementById('quizQuestion');
  var quizChoices = document.getElementById('quizChoices');
  var quizFeedback = document.getElementById('quizFeedback');
  var quizNext = document.getElementById('quizNext');
  var quizLive = document.getElementById('quizLive');

  function renderQuiz(){
    var item = quizData[quizIdx];
    quizProgress.textContent = "Question " + (quizIdx+1) + " of " + quizData.length;
    quizQuestion.textContent = item.q;
    quizChoices.innerHTML = "";
    quizFeedback.hidden = true;
    quizFeedback.innerHTML = "";
    quizNext.hidden = true;
    item.choices.forEach(function(choiceText, i){
      var li = document.createElement('li');
      var btn = document.createElement('button');
      btn.className = 'quiz-choice';
      btn.type = 'button';
      btn.textContent = choiceText;
      btn.addEventListener('click', function(){ answerQuiz(i, btn); });
      li.appendChild(btn);
      quizChoices.appendChild(li);
    });
  }

  function answerQuiz(i, btnEl){
    var item = quizData[quizIdx];
    var buttons = quizChoices.querySelectorAll('.quiz-choice');
    buttons.forEach(function(b){ b.disabled = true; });
    var correct = i === item.correct;
    if(correct) quizScore++;
    btnEl.classList.add(correct ? 'correct' : 'incorrect');
    if(!correct){ buttons[item.correct].classList.add('correct'); }
    quizFeedback.hidden = false;
    quizFeedback.innerHTML = '<span class="verdict">' + (correct ? "That's right." : "Not quite.") + '</span>' + item.explain;
    quizNext.hidden = false;
    quizNext.textContent = (quizIdx === quizData.length - 1) ? "See your score" : "Next question";
    quizNext.focus();
  }

  quizNext.addEventListener('click', function(){
    quizIdx++;
    if(quizIdx >= quizData.length){
      quizLive.innerHTML = '<div class="quiz-result"><p class="eyebrow">Quiz complete</p><span class="figure-num">' + quizScore + ' / ' + quizData.length + '</span><p>Nice work — head back to Causes or Effects to revisit anything you were not sure on.</p></div>';
      quizNext.hidden = true;
      var retry = document.createElement('button');
      retry.className = 'button secondary';
      retry.type = 'button';
      retry.textContent = 'Try again';
      retry.addEventListener('click', function(){
        quizIdx = 0; quizScore = 0;
        quizLive.innerHTML = '<p class="quiz-progress" id="quizProgress"></p><p class="quiz-q" id="quizQuestion"></p><ul class="quiz-choices" id="quizChoices"></ul><div class="quiz-feedback" id="quizFeedback" hidden></div>';
        quizProgress = document.getElementById('quizProgress');
        quizQuestion = document.getElementById('quizQuestion');
        quizChoices = document.getElementById('quizChoices');
        quizFeedback = document.getElementById('quizFeedback');
        retry.remove();
        renderQuiz();
      });
      document.querySelector('.quiz-actions').appendChild(retry);
      return;
    }
    renderQuiz();
  });
  renderQuiz();

  /* ---------- Glossary ---------- */
  var glossary = [
    {term:"Greenhouse gas", def:"A gas — such as carbon dioxide, methane or nitrous oxide — that traps heat in the atmosphere."},
    {term:"Carbon footprint", def:"The total amount of greenhouse gas emissions caused by a person, product or activity."},
    {term:"Fossil fuel", def:"Coal, oil or natural gas formed from ancient organic matter; burning them releases stored carbon as CO2."},
    {term:"Renewable energy", def:"Energy from sources that naturally replenish, such as wind, solar and hydroelectric power."},
    {term:"Biodiversity", def:"The variety of plant and animal life in a particular habitat or across the planet."},
    {term:"Sea-level rise", def:"The increase in average ocean height, driven by melting ice and the thermal expansion of warmer water."},
    {term:"IPCC", def:"The Intergovernmental Panel on Climate Change — the United Nations body that assesses and reports on climate science."},
    {term:"Net zero", def:"A state where any greenhouse gas emissions are balanced out by an equivalent amount removed from the atmosphere."},
    {term:"Carbon sequestration", def:"The process of capturing and storing carbon dioxide, for example in trees, soil or underground storage."},
    {term:"Climate vs weather", def:"Weather is the day-to-day conditions in one place; climate is the long-term average pattern of weather over decades."}
  ];
  var glossList = document.getElementById('glossList');
  var glossEmpty = document.getElementById('glossEmpty');
  function renderGlossary(filter){
    glossList.innerHTML = "";
    var f = (filter||"").trim().toLowerCase();
    var shown = 0;
    glossary.forEach(function(g){
      if(f && g.term.toLowerCase().indexOf(f) === -1 && g.def.toLowerCase().indexOf(f) === -1) return;
      shown++;
      var wrap = document.createElement('div');
      wrap.className = 'gloss-item';
      var dt = document.createElement('dt');
      dt.textContent = g.term;
      var dd = document.createElement('dd');
      dd.textContent = g.def;
      wrap.appendChild(dt); wrap.appendChild(dd);
      glossList.appendChild(wrap);
    });
    glossEmpty.style.display = shown === 0 ? 'block' : 'none';
  }
  document.getElementById('glossSearch').addEventListener('input', function(e){
    renderGlossary(e.target.value);
  });
  renderGlossary("");

})();
</script>
</body>
</html>
