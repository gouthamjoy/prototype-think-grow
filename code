<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Field Notes on Climate Change — Think and Grow</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Sans+3:opsz,wght@6..12,400;6..12,500;6..12,600;6..12,700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1E2B25; --ink-soft:#4B584F;
  --paper:#F5F1E6; --paper-raised:#ECE3CB; --paper-card:#FBF8F0;
  --moss:#2C6E5B; --moss-deep:#1B4E40; --moss-tint:#DCE9DF;
  --amber:#A15F16; --amber-tint:#F1E0BE;
  --rust:#9C3A22; --rust-tint:#F1DCCF;
  --sky:#38607A; --sky-tint:#DCE7EC;
  --line:#D9CFB0;
  --focus:#A15F16;
  --shadow: none;
  --radius-sm: 3px;
  --radius-md: 6px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --ink:#EAE5D6; --ink-soft:#BEB79E;
    --paper:#141C18; --paper-raised:#1D2721; --paper-card:#1A231E;
    --moss:#7FC7AC; --moss-deep:#4E9A7E; --moss-tint:#203129;
    --amber:#E3A855; --amber-tint:#31281A;
    --rust:#E08768; --rust-tint:#33221C;
    --sky:#8FC1DC; --sky-tint:#1B2A31;
    --line:#33403A;
    --focus:#E3A855;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --ink:#EAE5D6; --ink-soft:#BEB79E;
  --paper:#141C18; --paper-raised:#1D2721; --paper-card:#1A231E;
  --moss:#7FC7AC; --moss-deep:#4E9A7E; --moss-tint:#203129;
  --amber:#E3A855; --amber-tint:#31281A;
  --rust:#E08768; --rust-tint:#33221C;
  --sky:#8FC1DC; --sky-tint:#1B2A31;
  --line:#33403A;
  --focus:#E3A855;
  color-scheme: dark;
}
:root[data-theme="light"]{ color-scheme: light; }

*,*::before,*::after{ box-sizing:border-box; }
html{
  scroll-padding-top: calc(env(safe-area-inset-top,0px) + 12px);
}
html,body{ height:100%; }
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"Source Sans 3", system-ui, sans-serif;
  font-size: 17px;
  line-height:1.55;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  -webkit-text-size-adjust:100%;
}
[data-fontsize="large"] body, body[data-fontsize="large"]{ font-size:19.5px; }
h1,h2,h3,h4{
  font-family:"Fraunces", Georgia, serif;
  font-weight:600;
  line-height:1.15;
  margin:0 0 .5em;
  color:var(--ink);
}
p{ margin:0 0 1em; max-width:66ch; }
a{ color:var(--moss-deep); }
:root[data-theme="dark"] a, .theme-dark a{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) a{ color:var(--moss); } }
a:not(.button){ text-underline-offset:.15em; }
ul,ol{ padding-left:1.25em; }
img,svg{ max-width:100%; }
button{ font-family:inherit; }

:focus{ outline:none; }
:focus-visible{
  outline: 3px solid var(--focus);
  outline-offset: 2px;
  border-radius: 2px;
}

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
}

.skip-link{
  position:fixed; top:-100px; left:12px; z-index:200;
  background:var(--ink); color:var(--paper); padding:.75em 1.1em;
  border-radius: var(--radius-sm); font-weight:600; text-decoration:none;
}
.skip-link:focus{ top: calc(env(safe-area-inset-top,0px) + 12px); }

/* ---------- Shell layout ---------- */
.shell{
  display:grid;
  grid-template-columns: 260px 1fr;
  min-height:100%;
}
.railbar{
  border-right:1px solid var(--line);
  padding: 1.6rem 1.3rem;
  position:sticky; top:0;
  align-self:start;
  height:100vh; height:100dvh;
  display:flex; flex-direction:column;
  overflow-y:auto;
}
.brand{
  display:flex; align-items:center; gap:.6em;
  margin-bottom: 1.6rem;
  text-decoration:none;
}
.brand-mark{ flex:none; display:block; }
.brand-text{
  font-family:"Fraunces", serif; font-weight:600; font-size:1.05rem; color:var(--ink); line-height:1.15;
}
.brand-text span{ display:block; font-family:"Source Sans 3",sans-serif; font-weight:600; font-size:.68rem; letter-spacing:.02em; color:var(--ink-soft); margin-top:.15em; }

.mainnav{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.15rem; }
.mainnav a{
  display:flex; align-items:center; gap:.65em;
  padding:.6em .6em .6em .7em;
  text-decoration:none; color:var(--ink-soft);
  border-left:3px solid transparent;
  font-weight:600; font-size:.98rem;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}
.mainnav a:hover{ background:var(--paper-raised); color:var(--ink); }
.mainnav a[aria-current="page"]{
  color:var(--moss-deep); border-left-color:var(--moss);
  background:var(--moss-tint);
}
:root[data-theme="dark"] .mainnav a[aria-current="page"], .theme-dark .mainnav a[aria-current="page"]{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .mainnav a[aria-current="page"]{ color:var(--moss); } }
.mainnav .ico{ width:1.15em; height:1.15em; flex:none; }

.rail-tools{ margin-top:auto; padding-top:1.2rem; border-top:1px solid var(--line); display:flex; flex-direction:column; gap:.6rem; }
.rail-tools p{ font-size:.78rem; color:var(--ink-soft); margin:0 0 .3em; font-weight:600; }
.toolbtns{ display:flex; gap:.4rem; flex-wrap:wrap; }
.toolbtn{
  border:1px solid var(--line); background:var(--paper-card); color:var(--ink);
  padding:.4em .7em; border-radius: var(--radius-sm); cursor:pointer; font-size:.82rem; font-weight:600;
}
.toolbtn[aria-pressed="true"]{ background:var(--moss); border-color:var(--moss); color:var(--paper); }

.topbar{ display:none; }

main{ min-width:0; }
.page{ display:none; padding: 2.6rem clamp(1.2rem, 4vw, 3.4rem) 4rem; max-width: 980px; }
.page.is-active{ display:block; }
.eyebrow{ color:var(--moss-deep); font-weight:700; font-size:.85rem; margin-bottom:.5em; }
:root[data-theme="dark"] .eyebrow{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .eyebrow{ color:var(--moss); } }
.page h1{ font-size:clamp(2rem, 4vw, 2.9rem); max-width:16ch; }
.lede{ font-size:1.15rem; color:var(--ink-soft); max-width:58ch; }

.section-block{ margin-top:2.6rem; }
.section-block h2{ font-size:1.5rem; }
.hr{ border:none; border-top:1px solid var(--line); margin:2.6rem 0; }

/* ---------- Hero (home) ---------- */
.hero{
  display:grid; grid-template-columns: 1.1fr .9fr; gap:2.5rem; align-items:center;
  margin-bottom: 1rem;
}
.hero-copy h1{ font-size:clamp(2.1rem,4.4vw,3.3rem); }
.stat-row{ display:flex; gap:1.6rem; flex-wrap:wrap; margin-top:1.8rem; }
.stat{ min-width:9rem; }
.stat b{ display:block; font-family:"Fraunces",serif; font-size:2.1rem; font-weight:600; color:var(--moss-deep); line-height:1; }
:root[data-theme="dark"] .stat b{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .stat b{ color:var(--moss); } }
.stat span{ font-size:.85rem; color:var(--ink-soft); }
.hero-note{ font-size:.85rem; color:var(--ink-soft); margin-top:1.6rem; max-width:52ch; border-left:2px solid var(--line); padding-left:.9em; }

.card-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.1rem; margin-top:1.8rem; }
.route-card{
  border:1px solid var(--line); background:var(--paper-card); padding:1.2rem;
  border-radius: var(--radius-md); text-decoration:none; color:var(--ink); display:block;
}
.route-card:hover{ border-color:var(--moss); }
.route-card h3{ font-size:1.05rem; margin-bottom:.3em; }
.route-card p{ font-size:.9rem; color:var(--ink-soft); margin:0; }

/* ---------- generic content blocks ---------- */
.two-col{ display:grid; grid-template-columns: 1fr 1fr; gap:1.4rem; }
.info-card{ border:1px solid var(--line); background:var(--paper-card); border-radius:var(--radius-md); padding:1.3rem 1.4rem; }
.info-card h3{ font-size:1.05rem; }
.info-card p{ font-size:.94rem; margin-bottom:0; }
.figure-num{ font-family:"Fraunces",serif; font-size:2.4rem; font-weight:600; color:var(--amber); line-height:1; display:block; margin-bottom:.15em; }
.dl-list dt{ font-weight:700; margin-top:1em; }
.dl-list dd{ margin:0 0 0; color:var(--ink-soft); }

/* ---------- Greenhouse diagram (Causes) ---------- */
.greenhouse-wrap{
  border:1px solid var(--line); border-radius:var(--radius-md); background:var(--paper-card);
  padding:1.4rem; margin-top:1.6rem;
}
.greenhouse-grid{ display:grid; grid-template-columns: 1.1fr .9fr; gap:1.6rem; align-items:start; }
.gh-svg-box{ border-radius: var(--radius-sm); overflow:hidden; background: linear-gradient(180deg, var(--sky-tint), var(--paper-card) 78%); }
.hotspots{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.5rem; }
.hotspot-btn{
  width:100%; text-align:left; display:flex; align-items:center; gap:.7em;
  border:1px solid var(--line); background:var(--paper); color:var(--ink);
  padding:.7em .9em; border-radius:var(--radius-sm); cursor:pointer; font-weight:600; font-size:.95rem;
}
.hotspot-btn .dot{ width:.8em; height:.8em; border-radius:50%; flex:none; }
.hotspot-btn[aria-pressed="true"]{ border-color: var(--moss); background:var(--moss-tint); }
.gh-panel{ margin-top:1rem; padding-top:1rem; border-top:1px solid var(--line); font-size:.95rem; color:var(--ink-soft); min-height:4.5em; }
.gh-panel strong{ color:var(--ink); display:block; margin-bottom:.25em; font-family:"Fraunces",serif; font-size:1.05rem; font-weight:600; }
.gh-fade{ opacity:.35; transition:opacity .2s ease; }
.gh-active{ opacity:1; }

/* ---------- Tabs (Causes) ---------- */
.tablist{ display:flex; gap:.4rem; flex-wrap:wrap; border-bottom:1px solid var(--line); margin-top:2rem; }
.tab{
  border:1px solid var(--line); border-bottom:none; background:var(--paper);
  padding:.6em 1em; border-radius: var(--radius-sm) var(--radius-sm) 0 0; cursor:pointer; font-weight:600; color:var(--ink-soft);
  transform:translateY(1px);
}
.tab[aria-selected="true"]{ background:var(--paper-card); color:var(--ink); border-bottom:1px solid var(--paper-card); }
.tabpanel{ display:none; padding-top:1.4rem; }
.tabpanel.is-active{ display:block; }
.tabpanel .stat-mini{ font-family:"Fraunces",serif; font-size:1.6rem; color:var(--moss-deep); font-weight:600; }
:root[data-theme="dark"] .tabpanel .stat-mini{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .tabpanel .stat-mini{ color:var(--moss); } }

/* ---------- Timeline (Effects) ---------- */
.timeline-box{ border:1px solid var(--line); border-radius:var(--radius-md); background:var(--paper-card); padding:1.5rem; margin-top:1.6rem; }
.timeline-readout{ display:flex; align-items:baseline; gap:.8rem; margin-bottom:1rem; }
.timeline-readout b{ font-family:"Fraunces",serif; font-size:2.6rem; color:var(--rust); font-weight:600; }
.timeline-readout span{ color:var(--ink-soft); }
input[type="range"]{ width:100%; accent-color: var(--moss-deep); height:1.6rem; }
.timeline-scale{ display:flex; justify-content:space-between; font-size:.78rem; color:var(--ink-soft); margin-top:.3rem; }
.timeline-bars{ display:flex; align-items:flex-end; gap:3px; height:70px; margin-top:1.4rem; }
.timeline-bars i{ flex:1; background:var(--line); border-radius:1px 1px 0 0; display:block; }
.timeline-bars i.on{ background:var(--rust); }
.timeline-desc{ margin-top:1.2rem; font-size:.95rem; }

/* ---------- Accordion ---------- */
.accordion{ margin-top:1.6rem; border-top:1px solid var(--line); }
.acc-item{ border-bottom:1px solid var(--line); }
.acc-trigger{
  width:100%; text-align:left; background:none; border:none; cursor:pointer;
  padding:1em .2em; display:flex; justify-content:space-between; align-items:center; gap:1em;
  font-family:"Fraunces",serif; font-size:1.12rem; font-weight:600; color:var(--ink);
}
.acc-trigger .plus{ flex:none; width:1.3em; height:1.3em; position:relative; }
.acc-trigger .plus::before, .acc-trigger .plus::after{ content:""; position:absolute; background:var(--moss-deep); }
:root[data-theme="dark"] .acc-trigger .plus::before, :root[data-theme="dark"] .acc-trigger .plus::after{ background:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .acc-trigger .plus::before, :root:not([data-theme="light"]) .acc-trigger .plus::after{ background:var(--moss); } }
.acc-trigger .plus::before{ left:0; top:50%; width:100%; height:2px; transform:translateY(-50%); }
.acc-trigger .plus::after{ top:0; left:50%; height:100%; width:2px; transform:translateX(-50%); }
.acc-trigger[aria-expanded="true"] .plus::after{ display:none; }
.acc-panel{ display:none; padding:0 .2em 1.3em; color:var(--ink-soft); }
.acc-panel.is-open{ display:block; }
.acc-panel p{ margin-bottom:.6em; }

/* ---------- Action checklist ---------- */
.plan-box{ border:1px solid var(--line); border-radius:var(--radius-md); background:var(--paper-card); padding:1.5rem; margin-top:1.6rem; }
.plan-header{ display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin-bottom:1rem; }
.plan-score{ font-family:"Fraunces",serif; font-size:1.15rem; }
.plan-score b{ color:var(--moss-deep); }
:root[data-theme="dark"] .plan-score b{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .plan-score b{ color:var(--moss); } }
.plan-groups{ display:grid; grid-template-columns:1fr 1fr; gap:1.4rem; }
.plan-group h3{ font-size:1rem; margin-bottom:.6em; }
.plan-item{ display:flex; align-items:flex-start; gap:.6em; margin-bottom:.6em; font-size:.94rem; }
.plan-item input{ margin-top:.3em; width:1.1em; height:1.1em; accent-color:var(--moss-deep); flex:none; }
.plan-reset{ margin-top:1.2rem; }

/* ---------- Buttons ---------- */
.button{
  display:inline-flex; align-items:center; gap:.5em; text-decoration:none;
  background:var(--moss-deep); color:#F7F4E9; border:1px solid var(--moss-deep);
  padding:.65em 1.2em; border-radius:var(--radius-sm); font-weight:700; cursor:pointer; font-size:.95rem;
}
.button:hover{ background:var(--moss); border-color:var(--moss); }
.button.secondary{ background:transparent; color:var(--ink); border-color:var(--line); }
.button.secondary:hover{ border-color:var(--ink-soft); }
:root[data-theme="dark"] .button{ color:#12201A; }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .button{ color:#12201A; } }

/* ---------- Quiz ---------- */
.quiz-box{ border:1px solid var(--line); border-radius:var(--radius-md); background:var(--paper-card); padding:1.6rem; margin-top:1.6rem; }
.quiz-progress{ font-size:.85rem; color:var(--ink-soft); font-weight:600; margin-bottom:.6rem; }
.quiz-q{ font-family:"Fraunces",serif; font-size:1.3rem; font-weight:600; margin-bottom:1rem; }
.quiz-choices{ list-style:none; margin:0 0 1rem; padding:0; display:flex; flex-direction:column; gap:.55rem; }
.quiz-choice{
  width:100%; text-align:left; border:1px solid var(--line); background:var(--paper);
  padding:.75em .9em; border-radius:var(--radius-sm); cursor:pointer; font-size:.97rem; color:var(--ink);
}
.quiz-choice:hover{ border-color:var(--ink-soft); }
.quiz-choice.correct{ border-color:var(--moss-deep); background:var(--moss-tint); font-weight:700; }
.quiz-choice.incorrect{ border-color:var(--rust); background:var(--rust-tint); }
.quiz-choice[disabled]{ cursor:default; }
.quiz-feedback{ font-size:.94rem; padding-top:.3rem; }
.quiz-feedback .verdict{ font-weight:700; display:block; margin-bottom:.2em; }
.quiz-actions{ margin-top:1.2rem; display:flex; gap:.7rem; }
.quiz-result{ text-align:center; padding:1rem 0; }
.quiz-result .figure-num{ font-size:3rem; color:var(--moss-deep); }
:root[data-theme="dark"] .quiz-result .figure-num{ color:var(--moss); }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .quiz-result .figure-num{ color:var(--moss); } }

/* ---------- Glossary ---------- */
.gloss-search{ margin-top:1.4rem; }
.gloss-search input{
  width:100%; max-width:26rem; padding:.7em .9em; border:1px solid var(--line); border-radius:var(--radius-sm);
  background:var(--paper-card); color:var(--ink); font-size:.98rem;
}
.gloss-list{ margin-top:1.6rem; border-top:1px solid var(--line); }
.gloss-item{ border-bottom:1px solid var(--line); padding:1em 0; }
.gloss-item dt{ font-family:"Fraunces",serif; font-weight:600; font-size:1.05rem; }
.gloss-item dd{ margin:.3em 0 0; color:var(--ink-soft); font-size:.94rem; }
.gloss-empty{ color:var(--ink-soft); padding:1.4rem 0; display:none; }

footer.site-footer{
  border-top:1px solid var(--line); padding:2rem clamp(1.2rem,4vw,3.4rem) 2.6rem;
  font-size:.85rem; color:var(--ink-soft); max-width:980px;
}

.hscroll{ overflow-x:auto; }

/* ---------- Responsive ---------- */
@media (max-width: 900px){
  .shell{ grid-template-columns: 1fr; }
  .railbar{
    position:sticky; top:0; height:auto; padding: .8rem 1rem; z-index:50;
    flex-direction:row; align-items:center; border-right:none; border-bottom:1px solid var(--line);
    background:var(--paper);
    padding-top: calc(env(safe-area-inset-top,0px) + .8rem);
  }
  .brand{ margin-bottom:0; margin-right:.8rem; }
  .brand-text span{ display:none; }
  .mainnav{ flex-direction:row; overflow-x:auto; gap:.2rem; flex:1; }
  .mainnav a{ white-space:nowrap; border-left:none; border-bottom:3px solid transparent; padding:.6em .7em; border-radius:var(--radius-sm) var(--radius-sm) 0 0; }
  .mainnav a[aria-current="page"]{ border-left-color:transparent; border-bottom-color:var(--moss); }
  .mainnav .txt{ display:none; }
  .rail-tools{ display:none; }
  .page{ padding: 1.8rem 1.2rem 3rem; }
  .hero{ grid-template-columns:1fr; }
  .card-grid{ grid-template-columns:1fr; }
  .two-col{ grid-template-columns:1fr; }
  .greenhouse-grid{ grid-template-columns:1fr; }
  .plan-groups{ grid-template-columns:1fr; }
}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="shell">
  <nav class="railbar" aria-label="Site sections">
    <a class="brand" href="#home">
      <svg class="brand-mark" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
        <circle cx="15" cy="15" r="14" fill="none" stroke="var(--moss-deep)" stroke-width="1.4"/>
        <path d="M8 17c2-6 6-9 9-9M8 17c1 3 4 4.5 7 4M8 17c3 0 5-1 6-3" fill="none" stroke="var(--moss-deep)" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <span class="brand-text">Think and Grow<span>Field notes on climate change</span></span>
    </a>
    <ul class="mainnav" id="mainnav">
      <li><a href="#home" data-route="home" aria-current="page"><svg class="ico" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10l7-6 7 6M5 9v7h10V9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span class="txt">Home</span></a></li>
      <li><a href="#causes" data-route="causes"><svg class="ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="7" r="3.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 17c1.5-4 4-5 7-5s5.5 1 7 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span class="txt">Causes</span></a></li>
