    <!-- EFFECTS -->
    <section class="page" id="page-effects" aria-labelledby="effects-h1">
      <p class="eyebrow">Effects</p>
      <h1 id="effects-h1">How a warmer world shows up</h1>
      <p class="lede">A change measured in fractions of a degree doesn't sound dramatic — but small shifts in average temperature drive much bigger changes in weather, ice, oceans and ecosystems.</p>

      <div class="timeline-box">
        <h2 style="font-size:1.15rem;">Global temperature, decade by decade</h2>
        <label for="tlRange" style="display:block;font-size:.88rem;color:var(--ink-soft);margin-bottom:.8rem;">Drag the slider to move through time. Figures are approximate, relative to late-1800s levels.</label>
