              <circle cx="180" cy="80" r="3" fill="var(--sky)" class="gh-fade gh-atm-dot"/>
              <circle cx="270" cy="86" r="3" fill="var(--sky)" class="gh-fade gh-atm-dot"/>
              <circle cx="330" cy="92" r="3" fill="var(--sky)" class="gh-fade gh-atm-dot"/>
              <path d="M0 190c50 24 350 24 400 0v70H0z" fill="var(--moss-tint)" id="part-surface" class="gh-fade" stroke="var(--moss-deep)" stroke-width="1.4"/>
              <g id="part-heat" class="gh-fade" stroke="var(--rust)" stroke-width="1.6" stroke-linecap="round">
                <path d="M160 185c6-14 -4-20 0-32" fill="none"/>
                <path d="M200 185c6-14 -4-20 0-32" fill="none"/>
                <path d="M240 185c6-14 -4-20 0-32" fill="none"/>
                <path d="M160 153l6-9M200 153l6-9M240 153l6-9" fill="none"/>
              </g>
            </svg>
          </div>
          <div>
            <ul class="hotspots" id="ghHotspots">
              <li><button class="hotspot-btn" data-part="sun" aria-pressed="true"><span class="dot" style="background:var(--amber)"></span>The sun</button></li>
